{
  "name": "finquiry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"*.{md,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"*.{md,mjs,json}\"",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "lint:fix": "eslint . --fix",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:migrate:status": "payload migrate:status",
    "preseed": "node scripts/wait-for-db.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "start:prod": "node scripts/wait-for-db.mjs && payload migrate && next start",
    "qa:fixtures": "tsx qa/fixtures.ts",
    "qa:overflow": "node qa/overflow.mjs",
    "qa:links": "node qa/links.mjs",
    "qa:responsive": "node qa/responsive.mjs",
    "qa:resilience": "tsx qa/resilience.ts",
    "qa:media": "tsx qa/media-integrity.ts",
    "qa:seed-idempotency": "tsx qa/seed-idempotency.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/plugin-redirects": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "graphql": "^16.11.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  }
}
