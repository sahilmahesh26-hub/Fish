# ---------------------------------------------------------------------------
# Finquiry — environment variables
# Copy to `.env` and fill in real values. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string used by the Payload Postgres adapter.
DATABASE_URL=

# Long random string used to sign Payload auth tokens.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Absolute public origin of the site, no trailing slash.
# Used for canonical URLs, sitemap, OG images and WhatsApp links.
NEXT_PUBLIC_SITE_URL=

# --- Recommended ----------------------------------------------------------

# Fallback WhatsApp number in international format WITHOUT "+" or spaces.
#
# Site Settings > Contact > WhatsApp number in Payload takes precedence and is
# the place to set this in normal operation, because it applies immediately
# without a deploy. This variable is only a fallback for a fresh install.
#
# Read at RUNTIME, so changing it and restarting is enough. Do not use the old
# NEXT_PUBLIC_WHATSAPP_NUMBER: Next inlines NEXT_PUBLIC_* values at build time,
# so that one cannot be changed without rebuilding.
#
# Values that look like a number but are rejected as placeholders: any number
# whose subscriber part is one repeated digit or a straight run (919000000000,
# 911111111111, 911234567890). With no usable number every WhatsApp control on
# the site hides itself and the on-site enquiry CTA is shown instead.
WHATSAPP_NUMBER=

# Shared secret for draft preview links and on-demand revalidation.
PREVIEW_SECRET=
REVALIDATION_SECRET=

# The first Payload admin account, created by `pnpm seed` if it does not exist.
# There is no default password: in production the seed refuses to run without
# one, and in development it generates a random password and prints it once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- HTTPS (optional) -----------------------------------------------------

# Adds `preload` to the HSTS header. Only set this to true once the apex domain
# AND every required subdomain serve HTTPS — submitting to the preload list is
# effectively irreversible for months.
# HSTS itself is emitted automatically whenever NEXT_PUBLIC_SITE_URL is https.
HSTS_PRELOAD=

# --- Rate limiting (optional) ---------------------------------------------

# Public enquiry submissions allowed per IP per window.
# Defaults: 5 submissions per 10 minutes. Raise only for automated testing.
ENQUIRY_RATE_LIMIT_MAX=
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=

# --- Media storage (optional; local disk is used when unset) ---------------

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (optional; admin enquiry notifications are skipped when unset) --

EMAIL_FROM=
EMAIL_ADMIN_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Analytics (optional; provider-agnostic) ------------------------------

NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
