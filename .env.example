# ---------------------------------------------------------------------------
# Finquiry — environment variables
# Copy to `.env` and fill in real values. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string used by the Payload Postgres adapter.
DATABASE_URL=

# Long random string used to sign Payload auth tokens.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Absolute public origin of the site, no trailing slash.
# Used for canonical URLs, sitemap, OG images and WhatsApp links.
NEXT_PUBLIC_SITE_URL=

# --- Recommended ----------------------------------------------------------

# Fallback WhatsApp number in international format WITHOUT "+" or spaces,
# e.g. 919876543210. Site Settings in Payload takes precedence over this.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shared secret for draft preview links and on-demand revalidation.
PREVIEW_SECRET=
REVALIDATION_SECRET=

# --- Rate limiting (optional) ---------------------------------------------

# Public enquiry submissions allowed per IP per window.
# Defaults: 5 submissions per 10 minutes. Raise only for automated testing.
ENQUIRY_RATE_LIMIT_MAX=
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=

# --- Media storage (optional; local disk is used when unset) ---------------

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (optional; admin enquiry notifications are skipped when unset) --

EMAIL_FROM=
EMAIL_ADMIN_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Analytics (optional; provider-agnostic) ------------------------------

NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
